{
  "expo": {
    "name": "1 à 10",
    "slug": "un-a-dix",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "unadix",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yakisarame1.unadix",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EE"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EE"
        }
      ],
      "expo-status-bar",
      "expo-image",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "1 à 10 accède à ta galerie pour choisir la photo d'un joueur.",
          "cameraPermission": "1 à 10 utilise l'appareil photo pour prendre la photo d'un joueur."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0e789ab3-6dcf-4fc1-a398-961c6831da97"
      }
    }
  }
}
