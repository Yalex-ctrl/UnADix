{
  "expo": {
    "name": "1 à 10",
    "slug": "un-a-dix",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "unadix",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141221"
      }
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141221"
        }
      ],
      "expo-status-bar",
      "expo-image",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
